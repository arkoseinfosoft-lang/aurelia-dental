# Copy this file to .env for local dev, and add the same key in
# Vercel → Project → Settings → Environment Variables for production.
#
# The site works perfectly well with NO key set — the booking section
# will run in "Demo Mode" (simulated payment success, no money moves).
# Add your real Razorpay key to accept live payments.

# Get this from https://dashboard.razorpay.com/app/keys (use the
# publishable "Key Id", NEVER the Key Secret — that must stay server-side)
VITE_RAZORPAY_KEY_ID=

# Optional: WhatsApp number patients can chat with (country code, no + or spaces)
VITE_WHATSAPP_NUMBER=919999999999
